  "services": {
    "send_command": {
      "name": "Send command",
      "description": "Send a raw remote command to a Lomi (start, pause, resume, stop or program change).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Lomi to control."
        },
        "command": {
          "name": "Command",
          "description": "Command to send."
        },
        "mode": {
          "name": "Program",
          "description": "Program to use; defaults to the Program selector's value."
        },
        "start_at": {
          "name": "Start at",
          "description": "Optional future time to issue the command (scheduled start)."
        }
      }
    },
    "schedule_start": {
      "name": "Schedule start",
      "description": "Schedule a cycle to start at a future time.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Lomi to control."
        },
        "start_at": {
          "name": "Start at",
          "description": "When the cycle should start."
        },
        "mode": {
          "name": "Program",
          "description": "Program to use; defaults to the Program selector's value."
        }
      }
    },
    "cancel_scheduled": {
      "name": "Cancel scheduled start",
      "description": "Cancel one scheduled command, or all scheduled starts for the device.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Lomi to control."
        },
        "command_id": {
          "name": "Command ID",
          "description": "Specific command to cancel. Leave empty to cancel every scheduled start."
        }
      }
    },
    "register_device": {
      "name": "Register device",
      "description": "Register a Lomi to the account by serial number.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Which Lomi account to use (only needed with several accounts)."
        },
        "serial_number": {
          "name": "Serial number",
          "description": "Serial printed on the device, e.g. L3GBA0625000514."
        },
        "nickname": {
          "name": "Nickname",
          "description": "Name shown in the Lomi app and Home Assistant."
        }
      }
    }
  },
  "exceptions": {
    "device_not_found": {
      "message": "Device {device_id} not found."
