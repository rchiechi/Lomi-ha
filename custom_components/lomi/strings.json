{
  "config": {
    "step": {
      "user": {
        "title": "Sign in to Lomi",
        "description": "Use the same email and password as the Lomi app.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "register": {
        "title": "Register a Lomi",
        "description": "No Lomi is registered to {email} yet. Enter the serial number printed on the device (or skip and register in the app later).",
        "data": {
          "serial_number": "Serial number",
          "nickname": "Nickname"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Lomi",
        "description": "The Lomi cloud rejected the stored credentials for {email}. Enter the password again.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the Lomi cloud",
      "invalid_auth": "Email or password rejected",
      "invalid_serial": "Enter a serial number",
      "register_failed": "The Lomi cloud rejected that serial number",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This Lomi account is already configured",
      "reauth_successful": "Re-authentication was successful",
      "wrong_account": "Signed in to a different account than the one being re-authenticated"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Lomi options",
        "data": {
          "poll_interval": "Poll interval (seconds)",
          "poll_device_status": "Also poll /devices/status",
          "poll_pending_commands": "Also poll pending commands",
          "enable_shadow": "Realtime device shadow (MQTT)",
          "shadow_token": "Shadow auth: token",
          "shadow_transport": "Shadow auth: transport",
          "shadow_client_id": "Shadow auth: MQTT client ID",
          "shadow_mqtt_username": "Shadow auth: MQTT user name"
        },
        "data_description": {
          "poll_interval": "How often to fetch the device record from the Lomi cloud.",
          "poll_device_status": "Transient status route; observed empty while idle, may carry cycle state.",
          "poll_pending_commands": "Needed for scheduled-start and command-acknowledged tracking.",
          "enable_shadow": "Subscribe to the AWS IoT device shadow for live state (lid, running, cycle phase, time remaining). Falls back to polling when off or unreachable.",
          "shadow_token": "Which Cognito token to present to the IoT custom authorizer. The app uses the plain Id token.",
          "shadow_transport": "Where the token goes: WebSocket upgrade headers (what the app does), the URL query string, or the MQTT user name / password.",
          "shadow_client_id": "Template for the MQTT client ID. Placeholders: {uuid}, {user_id}, {sub}, {email}, {random}, {serial}, {thing}.",
          "shadow_mqtt_username": "MQTT CONNECT user name. The custom authorizer reads the device-ownership claim from its devices=<serial> part; {serial} is filled in automatically. Clear it only for experiments."
        }
      }
    }
  },
